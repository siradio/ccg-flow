DATABASE_URL=postgres://erp_user:erp_password@localhost:5432/erp_ccg
JWT_SECRET=change-me-in-production
# PORT : laisser tel quel en local. Sur Azure App Service, ne PAS définir cette variable —
# Azure fournit son propre PORT automatiquement, la définir soi-même casserait le démarrage.
PORT=4001

# --- Envoi d'emails -------------------------------------------------------------------------
# Deux canaux possibles. Microsoft Graph est PRIORITAIRE dès que ses 4 variables sont renseignées ;
# sinon on utilise SMTP ; sinon (rien de configuré) les emails sont loggés en console (dev).

# Microsoft Graph (recommandé O365, OAuth2 app-only — fin du Basic Auth SMTP). App registration Azure
# AD avec la permission APPLICATION Mail.Send (consentement admin). GRAPH_SENDER = boîte d'envoi (UPN).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=
GRAPH_FROM_NAME=CCG Flow

# SMTP (repli). Office 365 exige que le Basic Auth SMTP soit activé sur le tenant ET la boîte — de
# plus en plus bloqué par Microsoft ; préférer Graph ci-dessus. Laisser vide en dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Achats CCG" <achats@ccg-guinee.com>
